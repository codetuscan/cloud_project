# Copy to .env to override defaults used by docker-compose.yml
POSTGRES_USER=objstore
POSTGRES_PASSWORD=objstore
POSTGRES_DB=objstore
CONTROLLER_PORT=8090
# 1 MiB = 1048576 (set 1000000 if "1 MB" means decimal)
CHUNK_SIZE=1048576
HEARTBEAT_INTERVAL=5
HEARTBEAT_TIMEOUT=15
SCRUB_INTERVAL=1800
META_CACHE_ENABLED=true
META_CACHE_SIZE=1000
META_CACHE_TTL=30
CHUNK_CACHE_ENABLED=true
CHUNK_CACHE_BYTES=134217728
MAX_CONCURRENT_TRANSFERS=8
