# Copy to .env to override defaults used by docker-compose.yml
POSTGRES_USER=objstore
POSTGRES_PASSWORD=objstore
POSTGRES_DB=objstore
CONTROLLER_PORT=8090
# 1 MiB = 1048576 (set 1000000 if "1 MB" means decimal)
CHUNK_SIZE=1048576
HEARTBEAT_INTERVAL=5
HEARTBEAT_TIMEOUT=15
SCRUB_INTERVAL=1800
META_CACHE_ENABLED=true
META_CACHE_SIZE=1000
META_CACHE_TTL=30
CHUNK_CACHE_ENABLED=true
CHUNK_CACHE_BYTES=134217728
MAX_CONCURRENT_TRANSFERS=8
UPLOAD_ABANDON_SECONDS=3600
TOMBSTONE_RETENTION_SECONDS=86400
REPAIR_CONCURRENCY=2
REPAIR_SCAN_INTERVAL=10
RECONCILE_INTERVAL=30
ORPHAN_GRACE_SECONDS=120
SCRUB_RATE_MB_S=25
MAX_CONCURRENT_UPLOADS=4
MAX_CONCURRENT_DOWNLOADS=16
ADMISSION_TIMEOUT=30
MAX_UPLOAD_BYTES=21474836480
# rebalancer (moves replicas onto new workers, drains leaving ones)
REBALANCE_ENABLED=true
REBALANCE_INTERVAL=15
REBALANCE_TOLERANCE=2
REBALANCE_BATCH=16

# monitoring (Prometheus + Grafana)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
